VERITY_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=
VERITY_GEMINI_MODEL=gemini-2.5-flash
VERITY_OLLAMA_MODEL=llama3.2
VERITY_OLLAMA_BASE_URL=http://localhost:11434
DRY_RUN_TEST_MODE=false
VERITY_BROWSER_ENGINE=playwright
# Keep false unless browser Use runs behind enforced OS/container network egress restrictions.
VERITY_BROWSER_USE_NETWORK_ISOLATED=false
# Optional isolated Browser Use Python path. Blank auto-detects .venv-browser-use.
VERITY_BROWSER_USE_PYTHON=
VERITY_RESEARCH_ENABLED=true
VERITY_ENABLE_CREWAI=true
VERITY_BROWSER_TIMEOUT_SECONDS=15
# Per-call model timeout in seconds (5-600); bounds slow or stalled provider requests.
VERITY_MODEL_TIMEOUT_SECONDS=180
VERITY_DATABASE_PATH=data/verity.sqlite3
VERITY_OUTPUT_DIR=outputs
N8N_WEBHOOK_URL=
# Required before protected run/status API endpoints will accept requests; use >= 32 random characters.
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VERITY_API_KEY=
VERITY_API_HOST=0.0.0.0
# Per-process cap for queued/running API tasks (1-32); saturated requests return HTTP 429.
VERITY_MAX_ACTIVE_TASKS=4
VERITY_API_PORT=8000
