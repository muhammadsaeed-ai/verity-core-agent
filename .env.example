VERITY_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=
VERITY_GEMINI_MODEL=gemini-2.5-flash
VERITY_OLLAMA_MODEL=llama3.2
VERITY_OLLAMA_BASE_URL=http://localhost:11434
DRY_RUN_TEST_MODE=false
VERITY_BROWSER_ENGINE=playwright
# Optional isolated Browser Use Python path. Blank auto-detects .venv-browser-use.
VERITY_BROWSER_USE_PYTHON=
VERITY_RESEARCH_ENABLED=true
VERITY_ENABLE_CREWAI=true
VERITY_BROWSER_TIMEOUT_SECONDS=15
VERITY_DATABASE_PATH=data/verity.sqlite3
VERITY_OUTPUT_DIR=outputs
N8N_WEBHOOK_URL=
VERITY_API_HOST=0.0.0.0
VERITY_API_PORT=8000
